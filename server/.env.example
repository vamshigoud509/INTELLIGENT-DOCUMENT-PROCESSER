# DocuSphere IDP Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Google Gemini API Key (multimodal IDP model: gemini-1.5-flash / gemini-2.0-flash)
# Obtain your key free at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication Secret
JWT_SECRET=docusphere-super-secure-production-jwt-secret-key-2025
JWT_EXPIRES_IN=7d

# Supabase / PostgreSQL Database Connection (Optional - defaults to persistent local store if omitted)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
